# Copy to .env and edit. Never commit the real .env file.
# Every variable is optional - the defaults shown here are what the code uses.

# --- Chunking -------------------------------------------------------------
NLP_RAG_CHUNK_SIZE=800
NLP_RAG_CHUNK_OVERLAP=120

# --- Embeddings -----------------------------------------------------------
# auto | sentence-transformers | hashing
NLP_RAG_EMBEDDING_BACKEND=auto
NLP_RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Dimensionality used by the dependency-free hashing backend
NLP_RAG_EMBEDDING_DIM=384
NLP_RAG_EMBEDDING_BATCH_SIZE=32

# --- Vector index ---------------------------------------------------------
# auto | faiss | numpy
NLP_RAG_VECTOR_BACKEND=auto

# --- Retrieval ------------------------------------------------------------
# hybrid | dense | bm25
NLP_RAG_RETRIEVER=hybrid
NLP_RAG_TOP_K=5
# Reciprocal rank fusion constant used by the hybrid retriever
NLP_RAG_RRF_K=60
NLP_RAG_MIN_SCORE=0.0

# --- Generation -----------------------------------------------------------
# extractive | transformers | anthropic
NLP_RAG_GENERATOR=extractive
NLP_RAG_MAX_CONTEXT_CHARS=6000
NLP_RAG_TRANSFORMERS_MODEL=gpt2
NLP_RAG_TRANSFORMERS_MAX_NEW_TOKENS=160
NLP_RAG_ANTHROPIC_MODEL=claude-opus-5
NLP_RAG_ANTHROPIC_MAX_TOKENS=4096

# --- Storage --------------------------------------------------------------
NLP_RAG_INDEX_DIR=storage

# --- Secrets --------------------------------------------------------------
# Only needed when NLP_RAG_GENERATOR=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
